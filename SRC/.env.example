
# When running with Docker, use: MONGODB_URL=mongodb://mongodb:27017
# When running locally (development), use: MONGODB_URL=mongodb://localhost:27017
MONGODB_URL=mongodb://mongodb:27017

# ==== Default user configuration (created when initializing DB) ====
DEFAULT_USER_ID=018fbf68-bbde-7e3e-9424-8c7d06e0f8f0
DEFAULT_USER_NAME=admin
DEFAULT_USER_EMAIL=admin@admin.com
DEFAULT_USER_PASSWORD="240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9" # "admin123"
# USER_GROUP = "user"
DEFAULT_USER_ROLE="admin"

# ==== Length limit for input fields ====
MAX_LENGTH_EMAIL=254
MAX_LENGTH_NAME=254
MAX_LENGTH_PASS=64
MAX_LENGTH_DESCRIPTION=500
MAX_LENGTH_COMMENT=500
DEFAULT_PAGE=1
DEFAULT_PER_PAGE=20
DEFAULT_MAX_PER_PAGE=100

# time to check out new commit on git (minute)
CHECK_INTERVAL=1


# for windows when running docker then not needed
JAVA_PATH=C:\Program Files\Java\jdk-17\\bin\java.exe

# ==== MQTT Broker Configuration ====
# When running with Docker, use: MQTT_BROKER_HOST=mosquitto
# When running locally (development), use: MQTT_BROKER_HOST=localhost
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_WEBSOCKET_PORT=9001
MQTT_KEEPALIVE=60
MQTT_QOS=1

# MQTT Authentication (leave empty for anonymous access)
MQTT_USERNAME=
MQTT_PASSWORD=

# ==== Design Task Service Worker Configuration ====
# Number of retry attempts for a worker function in design_task_service
REGISTER_TASK_MAX_RETRY=3
# Maximum execution time (in seconds) for a worker function before timeout
WORKER_TIMEOUT=20

TASK_POLL_INTERVAL=5
TASK_POLL_BATCH_SIZE=100
ERROR_RETRY_DELAY=3
TASK_CONCURRENT_LIMIT=5
TASK_MAX_RETRY=3